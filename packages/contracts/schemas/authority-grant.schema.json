{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-talent.example/schemas/authority-grant/0.2.1",
  "title": "Authority Grant",
  "description": "Purpose- and action-scoped processing, contact, representation or disclosure authority record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "authority_id",
    "subject_id",
    "authority_type",
    "purpose_code",
    "actions",
    "basis_code",
    "evidence_ref",
    "valid_from",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "0.2.1" },
    "tenant_id": { "type": "string" },
    "authority_id": { "type": "string" },
    "subject_id": { "type": "string" },
    "authority_type": {
      "enum": ["processing", "contact", "representation", "disclosure", "work_pass_transaction"]
    },
    "purpose_code": { "type": "string" },
    "basis_code": { "type": "string" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["collect", "use", "contact", "represent", "disclose", "submit", "transact", "retain"] }
    },
    "data_categories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "employer_id": { "type": ["string", "null"] },
    "employer_uen": { "type": ["string", "null"] },
    "opportunity_id": { "type": ["string", "null"] },
    "recipient_id": { "type": ["string", "null"] },
    "channels": {
      "type": "array",
      "items": { "enum": ["email", "phone", "sms", "messaging", "in_app", "other"] },
      "uniqueItems": true
    },
    "evidence_ref": { "type": "string" },
    "notice_version": { "type": ["string", "null"] },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_to": { "type": ["string", "null"], "format": "date-time" },
    "status": { "enum": ["active", "expired", "withdrawn", "revoked", "superseded"] },
    "withdrawn_at": { "type": ["string", "null"], "format": "date-time" },
    "supersedes": { "type": ["string", "null"] },
    "attested_by": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}

