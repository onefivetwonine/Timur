# Inject configuration through Azure workload settings; no production .env files.
TIMUR_ENVIRONMENT=production
TIMUR_DATA_MODE=synthetic
TIMUR_AI_PROVIDER=deterministic
TIMUR_EXTERNAL_AI_ENABLED=false
# Empty until managed-identity PostgreSQL token acquisition/refresh is implemented.
# Never use migration/superuser credentials in the API.
DATABASE_URL=
PORT=8000
